{
	"version": 1,
	"hooks": {
		"beforeShellExecution": [
			{
				"command": "node .cursor/hooks/block-env-read.mjs",
				"failClosed": true
			},
			{
				"command": "node .cursor/hooks/pre-commit.mjs",
				"failClosed": true
			}
		],
		"beforeReadFile": [
			{
				"command": "node .cursor/hooks/block-env-read.mjs",
				"failClosed": true
			}
		]
	}
}
